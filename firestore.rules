rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSha256(value) {
      return value is string && value.size() == 64 && value.matches('^[a-f0-9]{64}$');
    }

    function isPermissionLevel(val) {
      return val in ['ALWAYS_ASK', 'LIMITED_AUTONOMY', 'MANUAL_APPROVAL_REQUIRED'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.preferredCurrency is string && data.preferredCurrency.size() >= 3 && data.preferredCurrency.size() <= 5 &&
        data.temperatureUnit in ['METRIC', 'IMPERIAL'] &&
        data.preferredCabinClass in ['ECONOMY', 'PREMIUM_ECONOMY', 'BUSINESS', 'FIRST'] &&
        data.homeAirportIata is string && data.homeAirportIata.size() >= 3 && data.homeAirportIata.size() <= 4 &&
        (!('travelStyle' in data) || (data.travelStyle is string && data.travelStyle.size() <= 40)) &&
        (!('budgetTier' in data) || (data.budgetTier is string && data.budgetTier.size() <= 30)) &&
        data.biometricThresholdUsd is number && data.biometricThresholdUsd >= 0 && data.biometricThresholdUsd <= 50000 &&
        data.darkGlassTheme is bool;
    }

    function isValidTripPlan(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 80 &&
        data.startDate is string && data.startDate.size() >= 1 && data.startDate.size() <= 30 &&
        data.endDate is string && data.endDate.size() >= 1 && data.endDate.size() <= 30 &&
        data.travellersCount is int && data.travellersCount >= 1 && data.travellersCount <= 20 &&
        data.budgetUsd is number && data.budgetUsd >= 0 && data.budgetUsd <= 250000 &&
        data.style is string && data.style.size() >= 1 && data.style.size() <= 40 &&
        data.status in ['PLANNED', 'UPCOMING', 'COMPLETED'];
    }

    function isValidBookingDoc(data, userId) {
      return data.userId == userId &&
        data.referenceCode is string && data.referenceCode.size() >= 3 && data.referenceCode.size() <= 40 &&
        data.bookingType in ['FLIGHT', 'HOTEL', 'CAR_RENTAL', 'DINING', 'ACTIVITY'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.providerSource is string && data.providerSource.size() >= 1 && data.providerSource.size() <= 80 &&
        (!('providerPnr' in data) || data.providerPnr == null) &&
        data.originOrLocation is string && data.originOrLocation.size() >= 1 && data.originOrLocation.size() <= 80 &&
        (!('destination' in data) || data.destination == null || (data.destination is string && data.destination.size() <= 80)) &&
        data.totalAmountUsd is number && data.totalAmountUsd >= 0 && data.totalAmountUsd <= 250000 &&
        data.status in ['REQUESTED', 'HELD', 'USER_APPROVED', 'NOT_BOOKABLE', 'CANCELLED'] &&
        isSha256(data.sha256AuditHash);
    }

    function isValidItinerarySlot(data, userId, tripId) {
      return data.userId == userId &&
        data.tripId == tripId &&
        data.dayNumber is int && data.dayNumber >= 1 && data.dayNumber <= 60 &&
        data.timeRange is string && data.timeRange.size() >= 1 && data.timeRange.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 160 &&
        (!('latitude' in data) || data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 1440 &&
        data.routeSequence is int && data.routeSequence >= 1 && data.routeSequence <= 200 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.estimatedCostUsd is number && data.estimatedCostUsd >= 0 && data.estimatedCostUsd <= 250000 &&
        data.calSyncStatus is string && data.calSyncStatus.size() >= 1 && data.calSyncStatus.size() <= 80;
    }

    function isValidAiMessage(data, userId) {
      return data.userId == userId &&
        data.isUser is bool &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
        (!('toolTraceSummary' in data) || data.toolTraceSummary == null || (data.toolTraceSummary is string && data.toolTraceSummary.size() <= 1000)) &&
        data.isError is bool;
    }

    function isValidSavedItem(data, userId) {
      return data.userId == userId &&
        data.itemType in ['DESTINATION', 'HOTEL', 'FLIGHT', 'ATTRACTION', 'ITINERARY'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        data.priceLabel is string && data.priceLabel.size() <= 40 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5;
    }

    function isValidAutonomousTask(data, userId) {
      return data.userId == userId &&
        (!('executionId' in data) || (data.executionId is string && data.executionId.size() <= 80)) &&
        (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.goal is string && data.goal.size() >= 1 && data.goal.size() <= 2000 &&
        data.understandingSummary is string && data.understandingSummary.size() <= 2000 &&
        data.status in ['RECEIVED', 'UNDERSTANDING', 'PLANNING', 'AWAITING_INPUT', 'RUNNING', 'EXECUTING', 'VERIFYING', 'PAUSED', 'WAITING_FOR_APPROVAL', 'WAITING_FOR_PERMISSION', 'COMPLETED', 'FAILED', 'CANCELLED'] &&
        data.totalSteps is int && data.totalSteps >= 0 && data.totalSteps <= 100 &&
        data.completedSteps is int && data.completedSteps >= 0 && data.completedSteps <= 100 &&
        data.checkpointJson is string && data.checkpointJson.size() <= 60000 &&
        data.finalOutcome is string && data.finalOutcome.size() <= 10000 &&
        data.reportMarkdown is string && data.reportMarkdown.size() <= 30000 &&
        (!('errorSummary' in data) || data.errorSummary == null || (data.errorSummary is string && data.errorSummary.size() <= 1000));
    }

    function isValidWorkspaceNote(data, userId) {
      return data.userId == userId &&
        (!('taskId' in data) || data.taskId == null || (data.taskId is string && data.taskId.size() <= 128)) &&
        data.noteType in ['NOTE', 'TASK_LIST', 'RESEARCH_REPORT'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 30000 &&
        data.tagsCsv is string && data.tagsCsv.size() <= 240;
    }

    function isValidWalletAccount(data, userId) {
      return data.userId == userId &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 5 &&
        data.verifiedBalanceMinor is int && data.verifiedBalanceMinor >= 0 && data.verifiedBalanceMinor <= 1000000000 &&
        data.pendingBalanceMinor is int && data.pendingBalanceMinor >= 0 && data.pendingBalanceMinor <= 1000000000 &&
        data.perTxLimitMinor is int && data.perTxLimitMinor >= 0 && data.perTxLimitMinor <= 100000000 &&
        data.dailyLimitMinor is int && data.dailyLimitMinor >= 0 && data.dailyLimitMinor <= 500000000 &&
        data.monthlyLimitMinor is int && data.monthlyLimitMinor >= 0 && data.monthlyLimitMinor <= 1000000000 &&
        data.dailySpentMinor is int && data.dailySpentMinor >= 0 &&
        data.monthlySpentMinor is int && data.monthlySpentMinor >= 0 &&
        data.emergencyLocked is bool &&
        data.isMinorAccount is bool &&
        data.guardianApproved is bool &&
        (!('guardianEmail' in data) || data.guardianEmail == null || (data.guardianEmail is string && data.guardianEmail.size() <= 160)) &&
        data.providerName is string && data.providerName.size() >= 1 && data.providerName.size() <= 60 &&
        (!('providerAccountRef' in data) || data.providerAccountRef == null || (data.providerAccountRef is string && data.providerAccountRef.size() <= 128)) &&
        data.reconciliationStatus in ['UNCONFIGURED', 'RECONCILED', 'MISMATCH', 'SYNC_PENDING'] &&
        !(data.reconciliationStatus == 'RECONCILED' && data.providerName == 'UNCONFIGURED') &&
        !(data.verifiedBalanceMinor > 0 && data.providerName == 'UNCONFIGURED') &&
        !(data.isMinorAccount && !data.guardianApproved && (data.verifiedBalanceMinor > 0 || data.pendingBalanceMinor > 0)) &&
        isSha256(data.reconciliationSha256) &&
        data.lastReconciledAtMs is int && data.lastReconciledAtMs >= 0;
    }

    function isValidWalletTransaction(data, userId) {
      return data.userId == userId &&
        data.txType in ['DEPOSIT', 'WITHDRAWAL', 'PURCHASE', 'REFUND', 'HOLD'] &&
        data.status in ['PENDING', 'AUTHORIZED', 'SUCCEEDED', 'FAILED', 'REFUNDED', 'CANCELLED'] &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128 &&
        (!('providerTransactionId' in data) || data.providerTransactionId == null || (data.providerTransactionId is string && data.providerTransactionId.size() <= 128)) &&
        data.providerVerificationStatus in ['UNVERIFIED', 'VERIFIED', 'MISMATCH', 'PROVIDER_NOT_CONFIGURED'] &&
        data.merchant is string && data.merchant.size() >= 1 && data.merchant.size() <= 120 &&
        data.productTitle is string && data.productTitle.size() >= 1 && data.productTitle.size() <= 160 &&
        data.deliveryOrBookingDetails is string && data.deliveryOrBookingDetails.size() <= 500 &&
        data.subtotalMinor is int && data.subtotalMinor >= 0 &&
        data.taxesAndFeesMinor is int && data.taxesAndFeesMinor >= 0 &&
        data.totalMinor is int && data.totalMinor >= 0 && data.totalMinor == data.subtotalMinor + data.taxesAndFeesMinor &&
        data.balanceBeforeMinor is int && data.balanceBeforeMinor >= 0 &&
        data.balanceAfterMinor is int && data.balanceAfterMinor >= 0 &&
        data.refundedMinor is int && data.refundedMinor >= 0 && data.refundedMinor <= data.totalMinor &&
        isSha256(data.receiptSha256) &&
        data.ownerAuthorized is bool &&
        (!(data.txType == 'PURCHASE' && data.status in ['AUTHORIZED', 'SUCCEEDED']) || data.ownerAuthorized == true) &&
        (!(data.status == 'SUCCEEDED') || (data.providerVerificationStatus == 'VERIFIED' && data.providerTransactionId is string && data.providerTransactionId.size() >= 1)) &&
        (!('failureReason' in data) || data.failureReason == null || (data.failureReason is string && data.failureReason.size() <= 500));
    }

    function isValidPermissionPolicy(data, userId) {
      return data.userId == userId &&
        isPermissionLevel(data.walletAccess) &&
        isPermissionLevel(data.purchasePermission) &&
        isPermissionLevel(data.emailRead) &&
        isPermissionLevel(data.emailSend) &&
        isPermissionLevel(data.browserAccess) &&
        isPermissionLevel(data.websiteLogin) &&
        isPermissionLevel(data.fileAccess) &&
        isPermissionLevel(data.bookingPermission) &&
        isPermissionLevel(data.autonomousTaskPermission) &&
        data.maxTxAmountMinor is int && data.maxTxAmountMinor >= 0 && data.maxTxAmountMinor <= 100000000 &&
        data.killSwitchActive is bool &&
        data.revokedDomainsCsv is string && data.revokedDomainsCsv.size() <= 2000;
    }

    function isValidEmailConnection(data, userId) {
      return data.userId == userId &&
        data.connectedEmail is string && data.connectedEmail.size() <= 160 &&
        data.alloraAlias is string && data.alloraAlias.size() >= 1 && data.alloraAlias.size() <= 180 &&
        data.mailboxProvisioned is bool &&
        data.connectionStatus in ['DISCONNECTED', 'OAUTH_CONNECTED', 'PROVISIONED_MAILBOX'] &&
        (!(data.mailboxProvisioned) || data.connectionStatus == 'PROVISIONED_MAILBOX') &&
        data.grantedScopesCsv is string && data.grantedScopesCsv.size() <= 500 &&
        data.allowNarrowAutoSend is bool &&
        data.allowedAutoSendRecipientsCsv is string && data.allowedAutoSendRecipientsCsv.size() <= 1000;
    }

    function isValidEmailItem(data, userId) {
      return data.userId == userId &&
        data.itemKind in ['INBOX_SUMMARY', 'DRAFT', 'SENT_LOG', 'RECEIPT'] &&
        (!('providerMessageId' in data) || data.providerMessageId == null || (data.providerMessageId is string && data.providerMessageId.size() <= 128)) &&
        data.recipient is string && data.recipient.size() <= 160 &&
        data.sender is string && data.sender.size() <= 160 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 240 &&
        data.snippet is string && data.snippet.size() <= 4000 &&
        data.aiSummary is string && data.aiSummary.size() <= 4000 &&
        data.status in ['SYNCED', 'DRAFT', 'AWAITING_APPROVAL', 'SENT', 'FAILED'] &&
        data.isImportant is bool;
    }

    function isValidBrowserTab(data, userId) {
      return data.userId == userId &&
        data.url is string && data.url.size() <= 2048 &&
        data.title is string && data.title.size() <= 200 &&
        data.isActive is bool &&
        data.isAutomationActive is bool;
    }

    function isValidBrowserRecord(data, userId) {
      return data.userId == userId &&
        data.recordType in ['HISTORY', 'BOOKMARK', 'DOWNLOAD', 'SITE_PERMISSION', 'SESSION'] &&
        data.domain is string && data.domain.size() <= 200 &&
        data.url is string && data.url.size() <= 2048 &&
        data.title is string && data.title.size() <= 240 &&
        data.permissionMode is string && data.permissionMode.size() <= 40 &&
        (!('filePath' in data) || data.filePath == null || (data.filePath is string && data.filePath.size() <= 500)) &&
        data.status is string && data.status.size() <= 40;
    }

    function isValidWorkspaceFile(data, userId) {
      return data.userId == userId &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120 &&
        data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 524288000 &&
        data.relativePath is string && data.relativePath.size() >= 1 && data.relativePath.size() <= 400 &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 80 &&
        isSha256(data.sha256);
    }

    function isValidSecurityAuditLog(data, userId) {
      return data.userId == userId &&
        data.category in ['AUTH', 'WALLET', 'PAYMENT', 'EMAIL', 'BROWSER', 'PERMISSION', 'TASK', 'ISOLATION'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
        data.outcome in ['ALLOWED', 'DENIED', 'BLOCKED', 'VERIFIED', 'FAILED', 'REVOKED'] &&
        data.detail is string && data.detail.size() <= 1000;
    }

    function isValidNotification(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        (!('actionRoute' in data) || data.actionRoute == null || (data.actionRoute is string && data.actionRoute.size() <= 80)) &&
        data.isUnread is bool;
    }

    function isValidAiPreferences(data, userId) {
      return data.userId == userId &&
        data.selectionMode in ['AUTOMATIC', 'PREFERRED_MODEL', 'MANUAL_MODE'] &&
        data.preferredModelId is string && data.preferredModelId.size() >= 1 && data.preferredModelId.size() <= 100 &&
        data.manualModelId is string && data.manualModelId.size() >= 1 && data.manualModelId.size() <= 100 &&
        data.autoSwitchOnFailure is bool;
    }

    function isValidAiFailoverLog(data, userId) {
      return data.userId == userId &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 80 &&
        data.taskProfile is string && data.taskProfile.size() >= 1 && data.taskProfile.size() <= 40 &&
        data.fromModelId is string && data.fromModelId.size() >= 1 && data.fromModelId.size() <= 100 &&
        data.toModelId is string && data.toModelId.size() >= 1 && data.toModelId.size() <= 100 &&
        data.reasonCategory is string && data.reasonCategory.size() >= 1 && data.reasonCategory.size() <= 60 &&
        data.statusCode is int &&
        data.detail is string && data.detail.size() <= 300 &&
        data.delayMs is int && data.delayMs >= 0;
    }

    function isValidMemoryEntry(data, userId) {
      return data.userId == userId &&
        data.category in ['USER_PREFERENCES', 'CONVERSATION_SUMMARIES', 'PROJECT_CONTEXT', 'USER_FACTS', 'ACTIVE_TASKS', 'FREQUENT_TOOLS'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 40 &&
        data.userApproved is bool &&
        data.retentionDays is int && data.retentionDays >= 0 && data.retentionDays <= 3650 &&
        data.expiresAt is int && data.expiresAt >= 0 &&
        data.usageCount is int && data.usageCount >= 0;
    }

    function isValidProject(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 2000 &&
        data.status in ['ACTIVE', 'PAUSED', 'COMPLETED', 'ARCHIVED'] &&
        data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.linkedTaskIdsCsv is string && data.linkedTaskIdsCsv.size() <= 2000 &&
        data.linkedFileIdsCsv is string && data.linkedFileIdsCsv.size() <= 2000 &&
        (!('linkedThreadId' in data) || data.linkedThreadId == null || (data.linkedThreadId is string && data.linkedThreadId.size() <= 120)) &&
        data.tagsCsv is string && data.tagsCsv.size() <= 240;
    }

    function isValidPersonalityProfile(data, userId) {
      return data.userId == userId &&
        data.presetMode in ['BALANCED_COMPANION', 'EXECUTIVE_AGENT', 'WARM_COMPANION', 'FUTURISTIC_OS'] &&
        data.warmthLevel is int && data.warmthLevel >= 0 && data.warmthLevel <= 100 &&
        data.concisenessLevel is int && data.concisenessLevel >= 0 && data.concisenessLevel <= 100 &&
        data.proactivityLevel is int && data.proactivityLevel >= 0 && data.proactivityLevel <= 100 &&
        data.explanationTransparency is bool &&
        data.voiceConsistencyEnabled is bool &&
        data.customSignatureNote is string && data.customSignatureNote.size() <= 300;
    }

    // Read-only global AI model catalog (no API keys or secrets stored here)
    match /ai_model_configs/{modelId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().keys().hasAll(['userId', 'displayName', 'preferredCurrency', 'temperatureUnit', 'preferredCabinClass', 'homeAirportIata', 'biometricThresholdUsd', 'darkGlassTheme', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'displayName', 'preferredCurrency', 'temperatureUnit', 'preferredCabinClass', 'homeAirportIata', 'travelStyle', 'budgetTier', 'biometricThresholdUsd', 'darkGlassTheme', 'createdAt', 'updatedAt']) &&
        incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredCurrency', 'temperatureUnit', 'preferredCabinClass', 'homeAirportIata', 'travelStyle', 'budgetTier', 'biometricThresholdUsd', 'darkGlassTheme', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /trips/{tripId} {
        allow get: if isValidId(userId) && isValidId(tripId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(tripId) && isOwner(userId) &&
          incoming().keys().hasAll(['userId', 'title', 'destination', 'startDate', 'endDate', 'travellersCount', 'budgetUsd', 'style', 'status', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'title', 'destination', 'startDate', 'endDate', 'travellersCount', 'budgetUsd', 'style', 'status', 'createdAt', 'updatedAt']) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          isValidTripPlan(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(tripId) && isOwner(userId) &&
          isValidTripPlan(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'destination', 'startDate', 'endDate', 'travellersCount', 'budgetUsd', 'style', 'status', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(tripId) && isOwner(userId);

        match /itinerary_slots/{slotId} {
          allow get: if isValidId(userId) && isValidId(tripId) && isValidId(slotId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(tripId) && isOwner(userId);
          allow create: if isValidId(userId) && isValidId(tripId) && isValidId(slotId) && isOwner(userId) &&
            exists(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)) &&
            incoming().keys().hasAll(['userId', 'tripId', 'dayNumber', 'timeRange', 'title', 'location', 'category', 'durationMinutes', 'routeSequence', 'notes', 'estimatedCostUsd', 'calSyncStatus', 'createdAt', 'updatedAt']) &&
            incoming().keys().hasOnly(['userId', 'tripId', 'dayNumber', 'timeRange', 'title', 'location', 'latitude', 'longitude', 'category', 'durationMinutes', 'routeSequence', 'notes', 'estimatedCostUsd', 'calSyncStatus', 'createdAt', 'updatedAt']) &&
            incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
            incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
            isValidItinerarySlot(incoming(), userId, tripId);
          allow update: if isValidId(userId) && isValidId(tripId) && isValidId(slotId) && isOwner(userId) &&
            isValidItinerarySlot(incoming(), userId, tripId) &&
            incoming().userId == existing().userId &&
            incoming().tripId == existing().tripId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['dayNumber', 'timeRange', 'title', 'location', 'latitude', 'longitude', 'category', 'durationMinutes', 'routeSequence', 'notes', 'estimatedCostUsd', 'calSyncStatus', 'updatedAt']);
          allow delete: if isValidId(userId) && isValidId(tripId) && isValidId(slotId) && isOwner(userId);
        }
      }

      match /bookings/{bookingId} {
        allow get: if isValidId(userId) && isValidId(bookingId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(bookingId) && isOwner(userId) &&
          incoming().keys().hasAll(['userId', 'referenceCode', 'bookingType', 'title', 'providerSource', 'originOrLocation', 'totalAmountUsd', 'status', 'sha256AuditHash', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'referenceCode', 'bookingType', 'title', 'providerSource', 'providerPnr', 'originOrLocation', 'destination', 'totalAmountUsd', 'status', 'sha256AuditHash', 'createdAt', 'updatedAt']) &&
          incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().status in ['REQUESTED', 'HELD', 'NOT_BOOKABLE'] &&
          isValidBookingDoc(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(bookingId) && isOwner(userId) &&
          isValidBookingDoc(incoming(), userId) &&
